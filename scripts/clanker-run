#!/usr/bin/env bash
set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]:-$0}"
SCRIPT_REAL="$(readlink -f "$SCRIPT_SOURCE")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_REAL")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=clanker-vite-lib.sh
source "$SCRIPT_DIR/clanker-vite-lib.sh"

cd "$ROOT"

if [[ ! -f .env ]]; then
  echo "clanker-run: varning: .env saknas i $ROOT (skapa från .env.example)." >&2
fi

clanker_load_dotenv

docker compose up -d --build "$@"
clanker_vite_start
