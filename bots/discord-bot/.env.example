# Bot token: Discord Developer Portal → din app → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Application ID: Developer Portal → General Information → Application ID
# Samma värde som DISCORD_CLIENT_ID i rot-.env
DISCORD_APPLICATION_ID=

# PostgreSQL — samma connection string som discord-hub-api använder.
# Lokalt npm utan Docker-nätverk:
# DATABASE_URL=postgresql://clanker:<lösenord>@127.0.0.1:5432/clanker_discord
# Om Postgres kör i Docker (clanker-db):
# DATABASE_URL=postgresql://clanker:<lösenord>@clanker-db:5432/clanker_discord
# Bot på Raspberry Pi, Postgres på workstation (LAN, POSTGRES_BIND_ADDRESS=0.0.0.0 + brandvägg):
# DATABASE_URL=postgresql://clanker:<lösenord>@192.168.x.x:5432/clanker_discord
# Specialtecken i lösenord måste URL-kodas (t.ex. encodeURIComponent i JS, eller manuellt %21 för !).
DATABASE_URL=

# Lokalt HTTP för hub → bot (play/skip/…). Om 3012 är upptagen (t.ex. discord-bot i Docker): byt port här och i rot-.env MUSIC_BOT_HTTP_URL.
# MUSIC_BOT_HTTP_PORT=3012

# Windows: bot sätter ipv4first för DNS som standard (trasig IPv6 kan blockera röst). Sätt till 0 för att stänga av:
# DISCORD_VOICE_IPV4_FIRST=0

# Spotify (spellistor/låtar via API → YouTube). Personliga spellistor kräver ofta användar-OAuth; botten använder client credentials.
# Många Spotify-redaktionella/algorithmiska spellistor ger 403 i Web API för nya appar (nov 2024); botten faller då tillbaka till open.spotify.com/embed (SSR).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Marknad för spelliste-spår (ISO 3166-1 alpha-2), standard US om utelämnad:
# SPOTIFY_DEFAULT_MARKET=SE

# Valfritt: sökväg till ffmpeg om seek/skrubb ska fungera och ffmpeg-static inte räcker (t.ex. minimal container).
# FFMPEG_PATH=/usr/bin/ffmpeg
# Valfritt: egen User-Agent vid embed-fallback om Spotify blockerar standard (sällan):
# SPOTIFY_EMBED_USER_AGENT=Mozilla/5.0 ...
# Parallella YouTube-sökningar när Spotify-spellista mappas till YouTube (1–24, standard 12). Högre = snabbare; för mycket kan ge rate limits.
# MUSIC_PLAYLIST_SEARCH_CONCURRENCY=16
