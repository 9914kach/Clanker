TZ=Europe/Stockholm
DNSMASQ_LISTENING=all
WEB_PORT=8080
FTLCONF_webserver_port=8080
FTLCONF_dns_interface=eth0

# --- Discord hub (docker compose --profile discord) ---
# DISCORD_HUB_WEB_PORT=4173

# --- Dev tools (docker compose --profile devtools) ---
# DEV_TOOLS_WEB_PORT=4174

# --- Caddy (docker compose --profile caddy) ---
# CADDY_HTTP_PORT=80
# Prod (standardvärdnamn)
# CLANKER_DISCORD_HOST=clanker.discord
# CLANKER_DEVTOOLS_HOST=clanker.tools
# Pi-hole admin — port i URL måste matcha WEB_PORT / FTLCONF_webserver_port ovan
# CLANKER_PIHOLE_HOST=clanker.pihole
# CLANKER_PIHOLE_UPSTREAM=http://host.docker.internal:8080
# Dev Vite på samma värd som Docker (502 om Vite inte kör)
# CLANKER_DISCORD_DEV_HOST=dev.clanker.discord
# CLANKER_DISCORD_DEV_UPSTREAM=http://host.docker.internal:5173
# CLANKER_DEVTOOLS_DEV_HOST=dev.clanker.tools
# CLANKER_DEVTOOLS_DEV_UPSTREAM=http://host.docker.internal:5174

# --- PostgreSQL (docker compose --profile db), för framtida API ---
# POSTGRES_USER=clanker
# POSTGRES_PASSWORD=byt_mig_starkt_lösenord
# POSTGRES_DB=clanker
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql://clanker:byt_mig_starkt_lösenord@127.0.0.1:5432/clanker
