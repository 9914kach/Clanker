# Valfritt: full URL till API om den inte delar origin (tom = samma host, använd /api via proxy i dev)
# VITE_API_URL=

# Valfritt: Vite proxar /api hit under dev (standard 3001). Sätts automatiskt från apps/discord-hub-api/.env PORT
# om den filen finns. Sätt här om du vill tvinga annat mål: DISCORD_HUB_API_DEV_PORT=3001
# DISCORD_HUB_API_DEV_PORT=3001

# Valfritt: Discord guild ID (snowflake) för live-/summary-widget på dashboard
# VITE_DISCORD_HUB_GUILD_ID=123456789012345678
