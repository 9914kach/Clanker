# Discord application: https://discord.com/developers/applications
# OAuth2 → Redirects: must match DISCORD_REDIRECT_URI exactly (including trailing slash policy).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Dev (Vite default): browser hits Vite; /api is proxied to this API.
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
# Where users land after successful login (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Random secret for signing session cookies (e.g. openssl rand -hex 32).
SESSION_SECRET=

# Optional; default 3001 (must match Vite proxy in discord-hub-web).
# PORT=3001
